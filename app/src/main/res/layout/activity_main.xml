<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:gravity="center_horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <!-- Top Section: Power Button -->
    <Button
        android:id="@+id/btnPower"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:text="POWER"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E53935"
        android:layout_marginBottom="24dp" />

    <!-- Middle Section: Volume | Circular Navigation | Channel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <!-- Volume Controls (Vertical) -->
        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="190dp"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="2dp"
            android:gravity="center">

            <Button
                android:id="@+id/btnVolUp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="VOL+"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2C2C2C" />

            <Button
                android:id="@+id/btnMute"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="MUTE"
                android:textSize="10sp"
                android:textColor="#FFB300"
                android:backgroundTint="#2C2C2C" />

            <Button
                android:id="@+id/btnVolDown"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="VOL-"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2C2C2C" />
        </LinearLayout>

        <!-- Circular Navigation Control -->
        <RelativeLayout
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="#1E1E1E">

            <Button
                android:id="@+id/btnNavUp"
                android:layout_width="60dp"
                android:layout_height="55dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:text="▲"
                android:textColor="#FFFFFF"
                android:backgroundTint="#333333" />

            <Button
                android:id="@+id/btnNavLeft"
                android:layout_width="55dp"
                android:layout_height="60dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="◀"
                android:textColor="#FFFFFF"
                android:backgroundTint="#333333" />

            <Button
                android:id="@+id/btnNavOk"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_centerInParent="true"
                android:text="OK"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#00897B" />

            <Button
                android:id="@+id/btnNavRight"
                android:layout_width="55dp"
                android:layout_height="60dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:backgroundTint="#333333" />

            <Button
                android:id="@+id/btnNavDown"
                android:layout_width="60dp"
                android:layout_height="55dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:text="▼"
                android:textColor="#FFFFFF"
                android:backgroundTint="#333333" />
        </RelativeLayout>

        <!-- Channel Controls (Vertical) -->
        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="190dp"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="2dp"
            android:gravity="center">

            <Button
                android:id="@+id/btnChUp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="CH+"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2C2C2C" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnChDown"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="CH-"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2C2C2C" />
        </LinearLayout>
    </LinearLayout>

    <!-- Third Row: Back and Exit Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="110dp"
            android:layout_height="55dp"
            android:layout_marginEnd="10dp"
            android:text="BACK"
            android:textColor="#FFFFFF"
            android:backgroundTint="#424242" />

        <Button
            android:id="@+id/btnExit"
            android:layout_width="110dp"
            android:layout_height="55dp"
            android:layout_marginStart="10dp"
            android:text="EXIT"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F" />
    </LinearLayout>

    <!-- Fourth Row: Home Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnHome"
            android:layout_width="230dp"
            android:layout_height="55dp"
            android:text="HOME"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1976D2" />
    </LinearLayout>

</LinearLayout>
